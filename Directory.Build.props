<Project>
    <PropertyGroup>
        <!-- The graph is watched, not only recorded. NuGet checks the restored graph
             against the advisory database and NU1901 to NU1904 are raised to errors, so a
             known-vulnerable package fails the restore. Left as warnings they would be
             true and green, printed into a log nobody reads.
    
             A committed lock file without an audit is the worse half of the pair: the
             graph is held still and nothing looks at it. This tree commits one for every
             project and restores locked everywhere, which is what makes the audit the
             missing half rather than a second opinion.
    
             Mode all rather than direct. What a project file names is the smaller half
             of the graph and a direct-only audit reads none of the rest. The rest is
             committed rather than argued about, so its size is one command:
    
                 git grep -c '"type": "Transitive"' Jellyfin.Plugin.ServerPairing/packages.lock.json
    
             Nothing is pinned here. What is pinned is the detector, not a repair, and
             whether the graph carries anything today is a reading rather than a sentence:
             run dotnet list package over the solution with its vulnerable and
             include-transitive switches. A clean reading says the graph carried nothing
             when it was run and says nothing about the next restore. The switches are
             named in words here for the reason the note below gives.
    
             Note for whoever edits this comment: an XML comment may not contain two
             hyphens in a row, so a command line flag spelled out here leaves the file
             malformed and the build fails on a property defined further down rather than
             on the comment. Name the flag in words instead. -->
        <NuGetAudit>true</NuGetAudit>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAuditLevel>low</NuGetAuditLevel>
        <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <Version>0.1.0.0</Version>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <FileVersion>0.1.0.0</FileVersion>
    </PropertyGroup>

    <!--
        The Jellyfin package version, once, for both projects and both server
        lines. A literal in each PackageReference would be four literals that
        have to move together, and the two that live in the test project are the
        ones a change forgets, because nothing about a plugin's own build says
        the test project references the same server.

        The value is chosen by the target framework because that is what the
        packages themselves are built for: 10.11.9 carries a net9.0 group and
        12.0.0-rc3 carries a net10.0 group, read from their nuspecs. Both are
        built from the tags this repository reads the server source at, which is
        what makes them the right pair rather than merely a working one:

            curl -s https://api.nuget.org/v3-flatcontainer/jellyfin.controller/10.11.9/jellyfin.controller.nuspec
            <repository ... commit="e83a7e62f26443f7dd98f126d6955ac1af090125" />
              <group targetFramework="net9.0">
            curl -s https://api.nuget.org/v3-flatcontainer/jellyfin.controller/12.0.0-rc3/jellyfin.controller.nuspec
            <repository ... commit="fc43f151a2418cc112e116050a99dd6318917ab0" />
              <group targetFramework="net10.0">

        Those two commits are v10.11.9 and v12.0-rc3.

        The conditions are written so a value handed in on the command line wins,
        which is how a build against a different server version is asked for
        without a second project file:

            dotnet build -f net9.0 -p:JellyfinPackageVersion=10.11.0
    -->
    <PropertyGroup>
        <JellyfinPackageVersion Condition="'$(JellyfinPackageVersion)' == '' and '$(TargetFramework)' == 'net9.0'">10.11.9</JellyfinPackageVersion>
        <JellyfinPackageVersion Condition="'$(JellyfinPackageVersion)' == '' and '$(TargetFramework)' == 'net10.0'">12.0.0-rc3</JellyfinPackageVersion>
    </PropertyGroup>

    <!--
        Analysis settings for every project in the tree, tests included.
        They live here rather than in a single csproj so that a project added
        later inherits them instead of having to remember them.

        The rule set travels with them. AnalysisMode turns rules on and the rule
        set is where this repository says which of them it does not want; a
        project that inherited one without the other would be judged by a
        severity nobody chose. The path is anchored to this file's own directory
        so it resolves the same from any project depth.
    -->
    <PropertyGroup>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <Nullable>enable</Nullable>
        <AnalysisMode>AllEnabledByDefault</AnalysisMode>
        <AnalysisModeSecurity>All</AnalysisModeSecurity>
        <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)jellyfin.ruleset</CodeAnalysisRuleSet>
    </PropertyGroup>

    <!--
        Same source, same bytes. ContinuousIntegrationBuild additionally
        normalises the paths embedded in the assembly, and it is set only where
        the checkout path is the runner's rather than a person's.
    -->
    <PropertyGroup>
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
