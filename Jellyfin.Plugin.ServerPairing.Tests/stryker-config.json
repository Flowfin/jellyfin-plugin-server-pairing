{
  "stryker-config": {
    "project": "Jellyfin.Plugin.ServerPairing.csproj",
    "target-framework": "net9.0",
    "mutate": [
      "Matching/*.cs",
      "Protocol/RequestAuthenticator.cs",
      "Protocol/CanonicalForm.cs",
      "Protocol/FieldShape.cs",
      "Protocol/FreshnessWindow.cs",
      "Protocol/PairingStateMachine.cs"
    ],
    "reporters": [
      "html",
      "markdown",
      "progress"
    ],
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 0
    }
  }
}
